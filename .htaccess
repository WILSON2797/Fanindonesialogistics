<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Sitemap Otomatis
  RewriteRule ^sitemap\.xml$ sitemap-gen.php [L]

  # 1. Biarkan request ke file fisik yang memang ada (misal gambar di uploads/)
  RewriteCond %{REQUEST_FILENAME} -f
  RewriteRule ^ - [L]

  # 2. Rute Khusus API: Arahkan semua request /api/* ke api/index.php
  RewriteCond %{REQUEST_URI} ^/api/
  RewriteRule ^api/(.*)$ api/index.php [L]

  # 3. Biarkan request ke folder subdomain (misal financeapps) berjalan normal
  RewriteCond %{REQUEST_URI} ^/financeapps/
  RewriteRule ^ - [L]

  # 4. Arahkan semua request halaman admin ke dist/admin/index.html
  RewriteRule ^admin(/.*)?$ dist/admin/index.html [L]

  # 5. Cek apakah file aset yang dicari ada di dalam folder dist/
  RewriteCond %{DOCUMENT_ROOT}/dist/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # 6. Fallback: Arahkan SEMUA request sisanya (termasuk root "/") ke dist/index.html
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>

# Keamanan Tambahan: Matikan Directory Listing
Options -Indexes

# Cache Control untuk Performa
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
