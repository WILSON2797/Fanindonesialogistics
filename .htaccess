<IfModule mod_rewrite.c>
  RewriteEngine On
  
  # Sitemap Otomatis
  RewriteRule ^sitemap\.xml$ sitemap-gen.php [L]
  
  # Jangan ganggu folder/file asli yang ada di root (seperti api/, uploads/, sitemap-gen.php, dll.)
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Arahkan semua request halaman admin (misal /admin atau /admin/dashboard) ke dist/admin/index.html
  RewriteRule ^admin(/.*)?$ dist/admin/index.html [L]

  # Arahkan request aset statis atau file yang dicari di dalam folder dist/
  RewriteCond %{DOCUMENT_ROOT}/$1 -f
  RewriteRule ^(.*)$ dist/$1 [L]

  # Arahkan semua request halaman publik ke dist/index.html (History Mode)
  RewriteRule ^(.*)$ dist/index.html [L]
</IfModule>

# Keamanan Tambahan: Matikan Directory Listing
Options -Indexes

# Cache Control untuk Performa
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 month"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
